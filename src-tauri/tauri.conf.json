{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PalCalc",
  "version": "0.4.0",
  "identifier": "dev.palcalc.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PalCalc — Palworld Breeding Calculator",
        "width": 1150,
        "height": 780,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
